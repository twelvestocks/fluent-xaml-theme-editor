                    <Color x:Key="SystemAccentColorLight2">#FF5CA7DE</Color>
                    <Color x:Key="SystemAccentColorLight3">#FF8BC1E6</Color>
                    <Color x:Key="RegionColor">#FF1E1E1E</Color>
                    <SolidColorBrush x:Key="RegionBrush" Color="{StaticResource RegionColor}" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
